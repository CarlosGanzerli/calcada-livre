# Copie para .env (que está no .gitignore) e troque os valores.
# Na nuvem este arquivo é gerado pelo Terraform em /etc/calcada-livre/.env com senhas aleatórias.
POSTGRES_PASSWORD=troque-esta-senha
ROBO_API_KEY=troque-esta-chave
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
# Local: :80   Nuvem: o nome DNS da VM (o Caddy emite o certificado HTTPS sozinho)
SITE_ADDRESS=:80
GHCR_OWNER=carlosganzerli
COMPOSE_PROFILES=monitoramento
